<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Window background shown before Compose draws; matches the Compose surface color. -->
    <style name="Theme.Reminder" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- 3.7.3：上游 SplashScreen API 依赖已移除，启动主题直接用系统主题 + 窗口背景。 -->
    <style name="Theme.Reminder.Starting" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- 任务执行界面: black system bars with light icons, matching the original full-screen
         alarm surface. Android 15+ forces edge-to-edge, so the Compose root handles insets. -->
    <style name="Theme.Reminder.Alarm" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
