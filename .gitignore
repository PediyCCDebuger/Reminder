# Gradle and build output
.gradle/
build/
.kotlin/
.externalNativeBuild/
.cxx/
captures/

# Machine-specific SDK path, written by Android Studio
local.properties

# IDE files. The Gradle build defines the project, so Android Studio regenerates these.
.idea/
*.iml

# OS
.DS_Store
Thumbs.db

# Release signing. Keep these offline; CI reads them from repository secrets.
keystore.properties
*.jks
*.keystore
*.p12
# The local base64 keystore is the offline source for the GitHub Secrets upload; it is NOT
# published and must never be committed. CI reads the key from repository secrets only.
.github/signing/

# Packages built outside build/, e.g. Android Studio's "Generate Signed APK" output in app/release/
*.apk
*.aab
/app/release/
# Downloaded CI build artifacts (sideload APKs fetched locally)
/out/

# Heap dumps from a crashed Gradle daemon
*.hprof

# Local release artifacts (CI uses $RUNNER_TEMP/dist, never the repo dist/)
dist/
